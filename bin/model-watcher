#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -f "$DIR/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    . "$DIR/.env"
    set +a
fi

if [ -f "$DIR/.venv/bin/python" ]; then
    PYTHON="$DIR/.venv/bin/python"
elif command -v uv >/dev/null 2>&1; then
    PYTHONPATH="$DIR/src:${PYTHONPATH:-}" exec uv run python3 -m model_watcher.cli "$@"
else
    PYTHON="python3"
fi

PYTHONPATH="$DIR/src:${PYTHONPATH:-}" exec "$PYTHON" -m model_watcher.cli "$@"
